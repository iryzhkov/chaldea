#!/usr/bin/env python3
"""Fetch signed bytes only; never check out or execute remote repository content."""
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import subprocess
import sys
import time

REMOTE = "ssh://git@github.com/iryzhkov/chaldea-trust.git"
REF = "refs/heads/trust-source"
BUNDLE = "bundle.jws"
MAX_BUNDLE = 262144
GIT_TIMEOUT = 20
# Git removes its own lock files on SIGTERM; SIGKILL only follows if it ignores that.
GIT_TERM_GRACE = 5
# Longer than any single bounded Git run, so a lock this old has no live writer.
STALE_LOCK_AGE = 60
STDERR_LINES = 4
STDERR_WIDTH = 240


def trusted(path, private=False):
    info = Path(path).lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
            or info.st_uid != os.geteuid()
            or info.st_mode & (0o077 if private else 0o022)):
        raise ValueError("unsafe input")


def trusted_runtime(path):
    target = Path(path)
    if not target.is_absolute():
        raise ValueError("runtime must be absolute")
    for entry in (target, *target.parents):
        info = entry.lstat()
        regular = stat.S_ISREG(info.st_mode) if entry == target else stat.S_ISDIR(info.st_mode)
        if not regular or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError("runtime and ancestors must be immutable root-owned paths")


def signal_group(proc, signum):
    try:
        os.killpg(proc.pid, signum)
    except ProcessLookupError:
        pass


def run_git(argv, env, timeout=GIT_TIMEOUT, pass_fds=()):
    """Run Git in its own process group and stop it gracefully on timeout.

    A plain SIGKILL leaves shallow.lock and ref locks behind and every later
    fetch fails; SIGTERM lets Git remove them before it exits.
    """
    with subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, start_new_session=True,
                          pass_fds=pass_fds) as proc:
        try:
            out, err = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            signal_group(proc, signal.SIGTERM)
            try:
                out, err = proc.communicate(timeout=GIT_TERM_GRACE)
            except subprocess.TimeoutExpired:
                signal_group(proc, signal.SIGKILL)
                out, err = proc.communicate()
            raise subprocess.TimeoutExpired(argv, timeout, output=out, stderr=err) from None
    if proc.returncode:
        raise subprocess.CalledProcessError(proc.returncode, argv, out, err)
    return out


def clear_stale_locks(cache, now=None):
    """Remove Git lock files left by a killed run.

    The caller holds the exclusive state lock, which every Git run started by
    this fetcher inherits, so no fetcher Git process can still own a lock. The
    age bound additionally spares a lock held by an operator's concurrent Git.
    """
    try:
        if not stat.S_ISDIR(cache.lstat().st_mode):
            return []
    except FileNotFoundError:
        return []
    now = time.time() if now is None else now
    removed = []
    for directory, _, names in os.walk(cache):
        for name in names:
            if not name.endswith(".lock"):
                continue
            path = Path(directory) / name
            try:
                info = path.lstat()
            except FileNotFoundError:
                continue
            if not stat.S_ISREG(info.st_mode) or now - info.st_mtime < STALE_LOCK_AGE:
                continue
            path.unlink(missing_ok=True)
            removed.append(str(path.relative_to(cache)))
    if removed:
        print("chaldea trust: removed stale transport cache lock(s): " + ", ".join(sorted(removed)),
              file=sys.stderr)
    return removed


def lock_state(state):
    fd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise RuntimeError("another trust update holds the state lock") from None
    return fd


def fetch(config):
    if config["repository"] != REMOTE or config["bundle_path"] != BUNDLE:
        raise ValueError("trust transport pin mismatch")
    trusted_runtime(config["node"])
    trusted_runtime(config["runtime"])
    state = Path(config["state"])
    info = state.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid()
            or info.st_mode & 0o077):
        raise ValueError("unsafe state")
    trusted(config["key"], private=True)
    trusted(config["known_hosts"])
    lock = lock_state(state)
    try:
        install(config, state, lock)
    finally:
        os.close(lock)


def install(config, state, lock):
    cache = state / "git"
    env = {
        "PATH": "/usr/bin:/bin", "HOME": str(state), "TMPDIR": str(state),
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0", "LC_ALL": "C",
        "GIT_SSH_COMMAND": shlex.join([
            "/usr/bin/ssh", "-F", "/dev/null", "-o", "BatchMode=yes",
            "-o", "IdentitiesOnly=yes", "-o", "IdentityAgent=none",
            "-o", "StrictHostKeyChecking=yes",
            "-o", "UserKnownHostsFile=" + config["known_hosts"],
            "-o", "GlobalKnownHostsFile=/dev/null", "-o", "UpdateHostKeys=no",
            "-o", "ConnectTimeout=10", "-o", "CheckHostIP=no",
            "-i", config["key"],
        ]),
    }

    def git(*args):
        # Git inherits the state lock so it stays held while any Git child lives.
        return run_git([
            "/usr/bin/git", "-c", "core.hooksPath=/dev/null", "-c", "gc.auto=0",
            "-c", "protocol.allow=never", "-c", "protocol.ssh.allow=always",
            *args,
        ], env=env, pass_fds=(lock,))

    if not cache.exists():
        git("init", "--bare", "--template=", str(cache))
    clear_stale_locks(cache)
    git("--git-dir=" + str(cache), "fetch", "--depth=1", "--no-tags",
        "--no-recurse-submodules", REMOTE, "+refs/heads/main:" + REF)
    commit = git("--git-dir=" + str(cache), "rev-parse", "--verify", REF).decode().strip()
    entry = git("--git-dir=" + str(cache), "ls-tree", commit, "--", BUNDLE).decode()
    if not entry.startswith("100644 blob ") or not entry.rstrip().endswith("\t" + BUNDLE):
        raise ValueError("nonregular bundle")
    obj = commit + ":" + BUNDLE
    size = int(git("--git-dir=" + str(cache), "cat-file", "-s", obj))
    if size < 1 or size > MAX_BUNDLE:
        raise ValueError("bundle size")
    envelope = git("--git-dir=" + str(cache), "cat-file", "blob", obj)
    if len(envelope) != size:
        raise ValueError("bundle changed")
    candidate = state / "candidate.jws"
    # state is private and trusted; never write a candidate in the public directory.
    fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(envelope)
    except BaseException:
        candidate.unlink(missing_ok=True)
        raise
    try:
        subprocess.run([
            config["node"], config["runtime"], "install-bundle",
            "--state-file", str(state / "updater.sqlite"),
            "--clock-health-file", config["health"],
            "--anchor-file", config["anchors"], "--bundle-file", str(candidate),
            "--output", config["output"],
        ], env=env, check=True, timeout=15)
    finally:
        candidate.unlink(missing_ok=True)
    # Housekeeping must not prevent installation or report a successful install as failed.
    try:
        git("--git-dir=" + str(cache), "reflog", "expire", "--expire=now", "--all")
        git("--git-dir=" + str(cache), "gc", "--prune=now", "--quiet")
    except (subprocess.SubprocessError, OSError) as error:
        print("chaldea trust: transport cache housekeeping failed: " + describe(error),
              file=sys.stderr)


def git_subcommand(argv):
    args = iter(argv[1:])
    for arg in args:
        if arg == "-c":
            next(args, None)
        elif not arg.startswith("-"):
            return arg
    return "command"


UNSAFE_STDERR = re.compile(r"PRIVATE KEY|BEGIN [A-Z ]*KEY|^[A-Za-z0-9+/=]{60,}$")


def stderr_excerpt(raw):
    """Return the decisive Git stderr lines as printable ASCII, or nothing.

    The window ends just after the first fatal or error line, because Git
    follows it with generic advice; ssh's own reason comes just before it.
    Git and ssh report paths, refs and host key fingerprints here, never the
    deploy key; anything resembling key material withholds the whole excerpt.
    """
    if not raw:
        return ""
    text = raw.decode("utf-8", "replace") if isinstance(raw, bytes) else str(raw)
    lines = []
    for line in text.replace("\r", "\n").splitlines():
        line = "".join(c if " " <= c <= "~" else "?" for c in line).strip()
        if UNSAFE_STDERR.search(line):
            return "(stderr withheld)"
        if line:
            lines.append(line[:STDERR_WIDTH])
    decisive = next((i for i, line in enumerate(lines)
                     if line.startswith(("fatal:", "error:"))), None)
    if decisive is not None:
        lines = lines[max(0, decisive - 2):decisive + 2]
    return " | ".join(lines[-STDERR_LINES:])


def describe(error):
    """A failure summary that never includes signed inputs or credentials."""
    if isinstance(error, (subprocess.CalledProcessError, subprocess.TimeoutExpired)):
        argv = error.cmd if isinstance(error.cmd, (list, tuple)) else []
        if argv and argv[0] == "/usr/bin/git":
            name = "git " + git_subcommand(argv)
            excerpt = stderr_excerpt(error.stderr)
        else:
            # The installer writes its own diagnostics straight to the journal.
            name, excerpt = "installer", ""
        if isinstance(error, subprocess.TimeoutExpired):
            summary = "%s timed out after %s s" % (name, error.timeout)
        else:
            summary = "%s exited %s" % (name, error.returncode)
        return summary + (": " + excerpt if excerpt else "")
    if isinstance(error, (ValueError, RuntimeError)) and not isinstance(error, UnicodeError):
        return str(error)[:STDERR_WIDTH]
    return type(error).__name__


def main():
    try:
        os.umask(0o077)
        if sys.argv[1] == "--check-runtime":
            if len(sys.argv) != 4:
                raise ValueError("runtime arguments")
            for path in sys.argv[2:]:
                trusted_runtime(path)
            return 0
        trusted(sys.argv[1])
        config = json.loads(Path(sys.argv[1]).read_text())
        fetch(config)
    except Exception as error:
        # Report only the sanitized cause: never credentials, signed inputs or stdout.
        print("chaldea trust: " + describe(error), file=sys.stderr)
        print("chaldea trust: update failed; cached signed expiry is unchanged", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
