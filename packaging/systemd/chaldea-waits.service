[Unit]
Description=Chaldea durable waits and decision inbox
After=network.target

[Service]
Type=simple
# Use the same reviewed app location as the quota service. No credential in argv.
ExecStart=%h/.local/share/mise/installs/node/26.10.0/bin/node %h/.local/share/chaldea/app/src/cli.ts waits serve --config %h/.config/chaldea/waits.json
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=chaldea
CacheDirectory=chaldea-waits
Restart=on-failure
RestartSec=1
UMask=0077
Environment=TMPDIR=%h/.cache/chaldea-waits
ExecStartPre=/usr/bin/mkdir -p %h/.cache/chaldea-waits
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/chaldea %h/.cache/chaldea-waits %t
PrivateTmp=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=null
# The service writes its own bounded 10 MiB/14-day event log.
StandardError=null

[Install]
WantedBy=default.target
