# Chaldea quota observer: records T3 usage-limit stops and T3's native
# auto-resumes in the fleet feed. User unit; install steps in docs/quota.md.
#
# Paths assume the reviewed checkout at /home/igor/.local/share/chaldea/app and
# the pinned Node from mise. The bearer token is read from a 0600 file by the
# program itself and never appears on a command line or in the environment.

[Unit]
Description=Chaldea quota observer (T3 usage limits to the feed)
Documentation=https://github.com/iryzhkov/chaldea/blob/main/docs/quota.md
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/home/igor/.local/share/mise/installs/node/26.10.0/bin/node /home/igor/.local/share/chaldea/app/src/cli.ts quota observe --t3-base-dir /home/igor/.t3 --token-file /home/igor/.config/chaldea/t3-token --state-file /home/igor/.local/state/chaldea/quota-observer.json --feed-command /home/igor/.local/bin/feed
Environment=PATH=/home/igor/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=/home/igor/.cache/chaldea
StateDirectory=chaldea
CacheDirectory=chaldea
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=10s
# 78 (EX_CONFIG): T3 refused the protocol, its data no longer matches the
# pinned contracts, or the token file is missing or not private. A restart
# cannot fix those; the unit stays failed until someone looks.
RestartPreventExitStatus=78
MemoryMax=256M
LogRateLimitIntervalSec=60s
LogRateLimitBurst=200

[Install]
WantedBy=default.target
