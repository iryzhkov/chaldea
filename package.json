{
  "name": "chaldea",
  "version": "0.1.0",
  "private": true,
  "description": "Chaldea: extensions to official T3 (quota observer first).",
  "type": "module",
  "bin": {
    "chaldea": "./bin/chaldea"
  },
  "engines": {
    "node": "26.10.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "scripts/with-scratch node --test 'test/unit/*.test.ts'",
    "test:e2e": "scripts/with-scratch node --test --test-concurrency=1 'test/e2e/*.test.ts'",
    "exec:check": "tsc -p tsconfig.exec.json",
    "exec:test": "node --test test/exec/*.test.ts",
    "exec:e2e": "node --test test/exec/e2e.ts"
  },
  "dependencies": {
    "effect": "4.0.4",
    "jose": "6.2.12",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
